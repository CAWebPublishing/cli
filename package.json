{
  "name": "@caweb/cli",
  "version": "1.17.7",
  "description": "CAWebPublishing Command Line Interface.",
  "exports": "./lib/env.js",
  "type": "module",
  "node": ">=22.11.0",
  "main": "./lib/env.js",
  "author": "CAWebPublishing",
  "license": "ISC",
  "bin": {
    "caweb": "bin/caweb.js"
  },
  "files": [
    "bin",
    "commands",
    "configs",
    "lib",
    "template"
  ],
  "scripts": {
    "caweb": "node bin/caweb.js",
    "update:webpack:flags": "node ./scripts/webpack-flags.js",
    "doc": "node ./scripts/documentation.js",
    "test": "echo \"Error: run tests from root\" && exit 0"
  },
  "homepage": "https://github.com/CAWebPublishing/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CAWebPublishing/cli.git"
  },
  "bugs": {
    "url": "https://github.com/CAWebPublishing/cli/issues"
  },
  "keywords": [
    "caweb",
    "cagov"
  ],
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "WP_VER": "7.0.4",
    "PHP_VER": "8.4",
    "CAWEB_VER": "1.13.4",
    "DIVI_VER": "4.27.5",
    "QUERY_MONITOR": "3.20.4",
    "DEFAULTS": {
      "FS_METHOD": "direct",
      "WP_DEBUG": true,
      "WP_DEBUG_LOG": true,
      "WP_DEBUG_DISPLAY": false,
      "WP_MEMORY_LIMIT": "256M",
      "WP_MAX_MEMORY_LIMIT": "512M",
      "WP_PERMALINK": "/%year%/%monthnum%/%postname%/",
      "WP_POST_REVISIONS": true,
      "WP_SITEURL": "http://localhost",
      "WP_HOME": "http://localhost",
      "ADMIN_COOKIE_PATH": "/",
      "COOKIE_DOMAIN": "",
      "COOKIEPATH": "",
      "SITECOOKIEPATH": "",
      "CONCATENATE_SCRIPTS": false
    }
  },
  "dependencies": {
    "@caweb/a11y-webpack-plugin": "^2.1.6",
    "@caweb/css-audit-webpack-plugin": "^2.1.5",
    "@caweb/html-webpack-plugin": "^2.1.19",
    "@caweb/jshint-webpack-plugin": "^2.1.5",
    "@caweb/webpack": "^2.0.16",
    "@inquirer/prompts": "^8.5.2",
    "@noble/hashes": "^2.3.0",
    "@wordpress/create-block": "^4.96.0",
    "@wordpress/env": "^11.13.0",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "crypto": "^1.0.1",
    "deepmerge": "^4.3.1",
    "docker-compose": "^1.4.2",
    "fast-xml-parser": "^5.10.1",
    "fs-extra": "^11.4.0",
    "html-to-json-parser": "^2.0.1",
    "inquirer-select-pro": "^1.0.0-alpha.9",
    "jsdom": "^30.0.1",
    "node-html-parser": "^9.0.1",
    "ora": "^9.4.1",
    "resolve-bin": "^1.0.1",
    "rimraf": "^6.1.3",
    "sitemap-webpack-plugin": "^1.1.1",
    "terminal-link": "^5.0.0"
  },
  "allowScripts": {
    "@caweb/css-audit-webpack-plugin@2.1.5": true,
    "accessibility-checker@4.0.30": true,
    "core-js@3.50.0": true,
    "fs-ext-extra-prebuilt@2.2.7": true,
    "chromedriver@152.0.0": true,
    "puppeteer@25.7.0": true,
    "@parcel/watcher@2.6.0": true
  }
}
